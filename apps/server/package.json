{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PROXY_ALLOWED_TARGETS='http://localhost:*,http://127.0.0.1:*' tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
